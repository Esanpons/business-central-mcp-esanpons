# Auth mode: "UserPassword" (default, on-prem forms /SignIn) or "AAD" (BC Online / SaaS).
# Leaving it unset = UserPassword = exact on-prem behavior. See the "BC Online (SaaS)"
# block at the bottom for AAD.
# BC_AUTH=UserPassword

# Required in UserPassword mode -- server will fail to start without these.
# In AAD mode they are OPTIONAL (used for headless Entra login; empty relies on the
# persisted browser profile bootstrapped via `npm run login:aad`).
BC_BASE_URL=http://Cronus27/BC
BC_USERNAME=
BC_PASSWORD=

# Optional
BC_TENANT_ID=default
BC_CLIENT_VERSION=27.0.0.0
# navigationContext.applicationId sent in OpenSession. BC 27 (ltsc2025) expects
# "NAV" (the default); "FIN" makes the server throw NavCancelCredentialPromptException
# on OpenSession even though HTTP auth and the WS handshake succeed. Override only
# if a different BC build expects another value.
BC_APPLICATION_ID=NAV
# BC profile id (e.g. "BUSINESS MANAGER"). Server uppercases and trims;
# unknown id silently falls back to user default. Empty = server default.
# Affects which Role Center loads and which pages Tell Me indexes.
# BC_PROFILE=
PORT=3000
LOG_LEVEL=info
LOG_DIR=./logs
STATE_DIR=./.state

# Self-signed on-prem certificate (a Docker BC container is the usual case).
# BC_TLS_INSECURE=1 disables certificate validation ONLY for the BC connections this
# server makes: the WebSocket upgrade, the forms /SignIn fetches, and the out-of-band
# headless browser. Prefer it over NODE_TLS_REJECT_UNAUTHORIZED=0, which switches off
# TLS verification for EVERY outbound connection of the whole process (Entra logins
# included). The global variable still works, so existing setups need no change.
# BC_TLS_INSECURE=1

# Response size guards (MCP tool results). Above the limit a tool returns a
# RESPONSE_TOO_LARGE error naming the narrowing parameters for that tool
# (summary / sections / columns / range / quiet) instead of blowing the client's
# token budget. An oversized inline screenshot drops ONLY the image block -- the PNG
# is always written to disk.
# BC_MAX_RESPONSE_CHARS=250000
# BC_MAX_INLINE_IMAGE_CHARS=1500000

# --- BC Online (SaaS) / AAD mode -----------------------------------------------
# Set BC_AUTH=AAD and point BC_BASE_URL at the environment (path-based, no ?tenant=):
#   BC_AUTH=AAD
#   BC_BASE_URL=https://businesscentral.dynamics.com/<aadTenantId>/<environment>
#   BC_SERVER_MAJOR=28
# BC_USERNAME/BC_PASSWORD (UPN + password) enable headless Entra login. With MFA:
#   BC_AAD_TOTP_SECRET=<base32 authenticator secret>   # unattended TOTP
# Or bootstrap once interactively (recommended when MFA can't be automated):
#   npm run login:aad     # opens a visible browser; log in + MFA once; profile persists
# Persistent browser profile that stores the Entra SSO session (reused headless):
# BC_AAD_PROFILE_DIR=./.state/aad-profile
# ms budget for the OIDC login dance:
# BC_AAD_LOGIN_TIMEOUT=120000
# BC_TENANT_ID in AAD mode: set to the value the F2 spike confirms (often the
# environment name); it feeds the OpenSession tenantId.
