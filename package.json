{
  "name": "business-central-mcp-esanpons",
  "version": "1.1.0",
  "description": "MCP server for Microsoft Dynamics 365 Business Central -- speaks BC's native WebSocket protocol directly. AESVA fork of SShadowS/business-central-mcp.",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "business-central-mcp": "dist/stdio-server.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:protocol": "vitest run tests/protocol",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:watch": "vitest",
    "start": "tsx src/server.ts",
    "start:stdio": "tsx src/stdio-adapter.ts",
    "start:stdio-direct": "tsx src/stdio-server.ts",
    "prepublishOnly": "tsc --noEmit && tsc",
    "validate:dxt": "npx -y @anthropic-ai/dxt validate manifest.json",
    "build:dxt": "tsx scripts/build-dxt.ts",
    "screenshot:poc": "tsx scripts/screenshot-poc.ts",
    "verify:manual-html": "tsx scripts/verify-manual-html.ts",
    "capture:report": "tsx scripts/capture-report-requestpage.ts",
    "capture:saas": "tsx scripts/capture-saas-handshake.ts",
    "login:aad": "tsx scripts/aad-login.ts",
    "test-battery": "tsx scripts/test-battery.ts"
  },
  "keywords": [
    "mcp",
    "business-central",
    "dynamics-365",
    "bc",
    "erp",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "author": "Esteve Sanpons (AESVA) <esteve@aesva.es>",
  "contributors": [
    "Torben Leth (upstream SShadowS/business-central-mcp)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Esanpons/business-central-mcp-esanpons"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "otpauth": "^9.5.1",
    "puppeteer-core": "^25.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.5.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "archiver": "^7.0.1",
    "dotenv": "^17.4.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
